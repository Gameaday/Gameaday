+# Network Privacy & Efficiency Booster
+# Pi-hole equivalent network-wide ad/tracking blocker + local caching proxy (apt-cacher-ng)
+
+version: '3.8'
+
+services:
+  pihole:
+    image: pihole/pihole:latest
+    container_name: pi-hole
+    restart: unless-stopped
+    ports:
+      - "53:53/tcp"
+      - "53:53/udp"
+      - "80:80"
+      - "443:443"
+    environment:
+      - TZ=America/New_York
